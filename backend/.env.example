# ==============================================================================
# GreenGrid Backend Environment Configuration Example
# Copy this file to .env and adjust variables for your local environment
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-greengrid-change-this-in-production-key-99214731
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
# Set DB_ENGINE=mysql to use MySQL database
# Set DB_ENGINE=sqlite to use SQLite for development/testing without MySQL running
DB_ENGINE=mysql
DB_NAME=greengrid_db
DB_USER=greengrid_user
DB_PASSWORD=your_secure_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
